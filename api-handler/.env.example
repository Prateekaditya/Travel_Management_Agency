MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=<appName>
MONGODB_DATABASE=travel-agency
JWT_SECRET=<your-base64-encoded-jwt-secret>
JWT_EXPIRATION_MS=86400000

# AWS SES (required for forgot-password email sending)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
SES_FROM_EMAIL=<verified-sender@yourdomain.com>