# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Backend ──────────────────────────────────────────────────────────────────
# Base URL for all API requests.
# • Development: leave commented out — the Vite dev-server proxy forwards
#   /api requests to http://localhost:8080 automatically (see vite.config.ts).
# • Staging / Production: set to the full backend URL, e.g.:
#   VITE_API_BASE_URL=https://api.your-domain.com/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Google reCAPTCHA v2 site key (get from https://www.google.com/recaptcha/admin)
# For local dev use: 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI (Google test key)
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# ── Auth endpoints ────────────────────────────────────────────────────────────
# Path appended to VITE_API_BASE_URL for the sign-up endpoint.
# Default value is used when this is not set.
# VITE_REGISTER_ENDPOINT=/auth/sign-up

# ── Misc ──────────────────────────────────────────────────────────────────────
# Static fallback user ID (only used when no JWT session exists).
# Leave empty — the real userId is extracted from the JWT token after login.
# VITE_USER_ID=